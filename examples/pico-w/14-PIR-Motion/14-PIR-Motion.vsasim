{
 "format": 2,
 "breadboard": "half",
 "parts": [
  {
   "id": "pico1",
   "kind": "pico-w",
   "x": -300,
   "y": 60,
   "rotation": 0,
   "flipH": false,
   "flipV": false,
   "props": {
    "program": "\"\"\"\n  PIR Motion Alarm\n  Lights an LED and prints a message when the PIR sensor sees motion.\n\n  A PIR sensor's OUT pin goes high when it sees a warm body move.\n  In VSA Simulator, click the sensor and tick \"Motion\".\n\n  The circuit:\n  - PIR VCC -> VBUS, GND -> GND\n  - PIR OUT -> GP14\n  - LED: GP15 -> 220 ohm resistor -> LED anode, LED cathode -> GND\n\n  You can modify this code and save it with another file name to simulate in\n  VSA Simulator.\n\n  Modified 03 November 2026 by Prof. Dattaraj S. Vidyasagar\n  Modified 04 November 2026 by Prof. Yash D. Vidyasagar\n\n  This example code is in the public domain.\n  For a great collection of example codes to simulate on VSA Simulator,\n  visit: https://github.com/dsvakola/VSA-Simulator\n  Or visit our official website: https://vsa.edu.in/\n  To check our collection of useful software, visit: https://github.com/dsvakola/software\n\"\"\"\n\nfrom machine import Pin\n\npir = Pin(14, Pin.IN)\nled = Pin(15, Pin.OUT)\nlast_state = 0   # so we print only when something changes\n\nwhile True:\n    motion = pir.value()\n    led.value(motion)   # the LED follows the sensor\n    if motion != last_state:\n        if motion == 1:\n            print(\"Motion detected!\")\n        else:\n            print(\"All quiet.\")\n        last_state = motion\n",
    "programName": "14-PIR-Motion.py"
   }
  },
