{
 "format": 2,
 "breadboard": "none",
 "parts": [
  {
   "id": "esp1",
   "kind": "esp8266-nodemcu",
   "x": 0,
   "y": 0,
   "rotation": 0,
   "flipH": false,
   "flipV": false,
   "props": {
    "program": "\"\"\"\n  I2C LCD Display\n  Shows a title and a running seconds counter on a 16x2 I2C LCD.\n\n  The LCD has a small I2C board on its back (address 0x27), so it needs\n  only 4 wires. It needs 5 V, so it takes its power from VIN.\n\n  You do not need to copy any library files; VSA Simulator adds them\n  itself. On a real board, copy esp8266_i2c_lcd.py and lcd_api.py onto the board with\n  Thonny first.\n\n  The circuit:\n  - LCD GND -> GND, VCC -> VIN\n  - SDA -> D2 (GPIO4)\n  - SCL -> D1 (GPIO5)\n\n  You can modify this code and save it with another file name to simulate in\n  VSA Simulator.\n\n  Modified 03 November 2026 by Prof. Dattaraj S. Vidyasagar\n  Modified 04 November 2026 by Prof. Yash D. Vidyasagar\n\n  This example code is in the public domain.\n  For a great collection of example codes to simulate on VSA Simulator,\n  visit: https://github.com/dsvakola/VSA-Simulator\n  Or visit our official website: https://vsa.edu.in/\n  To check our collection of useful software, visit: https://github.com/dsvakola/software\n\"\"\"\n\nfrom machine import Pin, I2C\nfrom esp8266_i2c_lcd import I2cLcd\nimport time\n\ni2c = I2C(sda=Pin(4), scl=Pin(5))\nlcd = I2cLcd(i2c, 0x27, 2, 16)   # address, 2 lines, 16 columns\n\nlcd.backlight_on()\nlcd.move_to(0, 0)        # column 0, line 0 (the top line)\nlcd.putstr(\"VSA Simulator\")\nlcd.move_to(0, 1)        # column 0, line 1 (the bottom line)\nlcd.putstr(\"Seconds: \")\nstart = time.ticks_ms()\n\nwhile True:\n    seconds = time.ticks_diff(time.ticks_ms(), start) // 1000\n    lcd.move_to(9, 1)    # just after \"Seconds: \"\n    lcd.putstr(str(seconds))\n    time.sleep_ms(200)\n",
    "programName": "18-I2C-LCD.py"
   }
  },
  {
   "id": "lcd1",
   "kind": "lcd-i2c",
   "x": 330,
   "y": 20,
   "rotation": 0,
   "flipH": false,
   "flipV": false,
   "props": {
    "address": "0x27"
   }
  }
 ],
