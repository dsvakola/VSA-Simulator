{
 "format": 2,
 "breadboard": "half",
 "parts": [
  {
   "id": "esp1",
   "kind": "esp8266-nodemcu",
   "x": -300,
   "y": 60,
   "rotation": 0,
   "flipH": false,
   "flipV": false,
   "props": {
    "program": "\"\"\"\n  IR Obstacle Sensor\n  Lights an LED when the infrared sensor sees an obstacle.\n\n  The IR obstacle sensor's OUT pin goes LOW (0) when something is close\n  in front of it.\n  In VSA Simulator, click the sensor and move the distance slider.\n\n  The circuit:\n  - IR sensor VCC -> 3V3, GND -> GND\n  - IR sensor OUT -> D5 (GPIO14)\n  - LED: D6 (GPIO12) -> 220 ohm resistor -> LED anode, LED cathode -> GND\n\n  The program also prints messages in the Shell, to show how a program can print text.\n\n  You can modify this code and save it with another file name to simulate in\n  VSA Simulator.\n\n  Written on 23 September 2026 by Prof. Dattaraj S. Vidyasagar\n  Modified on 07 November 2026 by Prof. Yash D. Vidyasagar\n\n  This example code is in the public domain.\n  For a great collection of example codes to simulate on VSA Simulator,\n  visit: https://github.com/dsvakola/VSA-Simulator\n  Or visit our official website: https://vsa.edu.in/\n  To check our collection of useful software, visit: https://github.com/dsvakola/software\n\"\"\"\n\nfrom machine import Pin\n\nsensor = Pin(14, Pin.IN)\nled = Pin(12, Pin.OUT)\nlast_state = 1\n\nwhile True:\n    clear = sensor.value()   # 0 = object found\n    if clear == 0:\n        led.value(1)\n    else:\n        led.value(0)\n    if clear != last_state:\n        print(\"Obstacle ahead!\" if clear == 0 else \"The way is clear.\")\n        last_state = clear\n",
    "programName": "15-IR-Obstacle.py"
   }
  },
